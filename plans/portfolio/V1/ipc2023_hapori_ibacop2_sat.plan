(LOAD C1 THERMO1 RAWSTORAGE_THERMOMETERS RTH2)
(MOVE C1 RTH2 RTH1)
(MOVE C1 RTH1 RCY3)
(MOVE C1 RCY3 RCY2)
(ROUTE C1 RCY2 RCY1)
(ROUTE C1 RCY1 PR3)
(MOVE C1 PR3 PR2)
(PROCESS C1 THERMO1 PR2 PROCESSINGSTATION)
(ROUTE C1 PR2 PR1)
(ROUTE C1 PR1 QU3)
(ROUTE C1 QU3 QU2)
(INSPECT C1 THERMO1 QUALITYCHECK QU2)
(MOVE C1 QU2 QU1)
(ROUTE C1 QU1 AS3)
(ROUTE C1 AS3 AS2)
(ASSEMBLE C1 THERMO1 ROBOTICASSEMBLY AS2)
(MOVE C1 AS2 AS1)
(MOVE C1 AS1 BU3)
(ROUTE C1 BU3 BU2)
(ROUTE C1 BU2 BU1)
(MOVE C1 BU1 SH3)
(ROUTE C1 SH3 SH2)
(SHIP C1 THERMO1 SHIPPINGAREA SH2)
